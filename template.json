{
  "name": "forklab",
  "description": "Test against real Hedera locally with Foundry, HTS, and the Hedera Schedule Service emulator.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"],
      "packageManager": ["yarn", "npm"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "yarn"
    },
    "outro": {
      "sections": [
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Run the Foundry environment check",
              "command": "{run:foundry:doctor}"
            },
            {
              "label": "Run offline emulator tests",
              "command": "{run:foundry:test}"
            },
            {
              "label": "Read the two-minute orientation while the first fork warms up",
              "url": "https://github.com/Jennycruzy/scaffold-hbar-forklab#two-minute-orientation"
            },
            {
              "label": "Run the mainnet fork tests",
              "command": "{run:foundry:test:fork}"
            },
            {
              "label": "Deploy RecurringBuy and its factory to testnet",
              "command": "{run:foundry:deploy}"
            },
            {
              "label": "Associate, approve, configure, fund, and start a vault",
              "url": "https://github.com/Jennycruzy/scaffold-hbar-forklab#deploy-and-start-a-testnet-vault"
            },
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            }
          ]
        }
      ]
    }
  }
}
